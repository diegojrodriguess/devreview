# Variáveis da stack Docker (docker-compose.yml).
# Copie para `.env` apenas se quiser mudar algo — o compose já funciona sem
# este arquivo, usando exatamente os valores abaixo como padrão.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=54322

# Role usado pelo PostgREST para conectar e fazer SET ROLE conforme o JWT.
AUTHENTICATOR_PASSWORD=authenticator

# --- API REST (nginx + PostgREST) ---
API_PORT=54321

# Mesmo segredo do Supabase local: mantém as anon/service keys dos
# apps/*/.env.example funcionando sem alteração. Trocar aqui exige gerar
# novas keys (HS256) com o claim "role".
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# --- pgAdmin ---
PGADMIN_EMAIL=admin@devreview.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=54323
